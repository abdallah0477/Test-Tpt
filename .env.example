# Copy to .env (gitignored). Never commit real values.


# Overrides for config.toml defaults (optional)
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# RUNNER_URL=http://runner:8100
# CLOUD_ENABLED=false
# LOG_LEVEL=INFO
# Any other key: TPT__<SECTION>__<KEY>=value, e.g.
# TPT__INSPECTION__LOAD_TIMEOUT_MS=45000

# Linux: run containers as your user so data/ stays yours (see `id -u` / `id -g`)
# HOST_UID=1000
# HOST_GID=1000
